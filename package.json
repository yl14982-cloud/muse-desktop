{
  "name": "muse-desktop",
  "version": "0.6.0",
  "private": true,
  "description": "A local-first Windows desktop cat, task board and focus timer with optional Notion sync",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check focus-store.js && node --check main.js && node --check preload.js && node --check renderer.js && node --check notion-sync.js && node --check scripts/test-state.js && node --check task-store.js && node --check scripts/test-packaged.js",
    "test": "node scripts/test-state.js && node scripts/test-notion.js && node scripts/test-focus.js && node scripts/test-tasks.js && node scripts/test-app-sync.js",
    "dist:win": "electron-builder --win nsis portable",
    "pack:win": "electron-builder --win portable",
    "test:packaged": "node scripts/test-packaged.js"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.muse.desktop",
    "productName": "Muse Desktop",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "renderer.js",
      "preload.js",
      "notion-sync.js",
      "focus-store.js",
      "task-store.js",
      "index.html",
      "style.css",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/muse.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Muse Desktop",
      "artifactName": "Muse-Desktop-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Muse-Desktop-Portable-${version}-${arch}.${ext}"
    },
    "artifactName": "Muse-Desktop-${version}-${arch}.${ext}"
  },
  "overrides": {
    "minimatch@>=7 <11.0.1": "11.0.1"
  }
}
