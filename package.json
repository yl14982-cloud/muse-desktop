{
  "name": "muse-desktop",
  "version": "0.5.4",
  "private": true,
  "description": "Muse: a calm Windows desktop cat with daily tasks and a focus timer",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check focus-store.js && node --check main.js && node --check preload.js && node --check renderer.js && node --check notion-sync.js && node --check scripts/test-state.js",
    "test": "node scripts/test-state.js && node scripts/test-notion.js && node scripts/test-focus.js",
    "dist:win": "electron-builder --win nsis portable",
    "pack:win": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.muse.desktop",
    "productName": "Muse Desktop",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "renderer.js",
      "preload.js",
      "notion-sync.js",
      "focus-store.js",
      "index.html",
      "style.css",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/muse.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Muse Desktop",
      "artifactName": "Muse-Desktop-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Muse-Desktop-Portable-${version}-${arch}.${ext}"
    },
    "artifactName": "Muse-Desktop-${version}-${arch}.${ext}"
  }
}
